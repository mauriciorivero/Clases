# Parametros de conexion a la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=authentication
DB_USER=personal_manager
DB_PASSWORD=

# Puerto donde se levanta el servidor Express
SERVER_PORT=3001

# Firma de los tokens: debe ser igual a la de BACKEND_SRV_2.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Duracion de la sesion
JWT_EXPIRES_IN=1h
